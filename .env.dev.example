DATABASE_URL=postgresql+asyncpg://<user>:<password>@<postgres-flexible-server>.postgres.database.azure.com:5432/tools_cabinet?ssl=require

JWT_SECRET=mega-super-duper-strong-secret
JWT_EXPIRES_MINUTES=60
COOKIE_DOMAIN=.toolscabinet.app
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://web.toolscabinet.app,https://imageconvert.toolscabinet.app

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=<https://<storage-account>.blob.core.windows.net>
AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=<https://<storage-account>.blob.core.windows.net>

SERVICEBUS_CONNECTION_STRING=<connection string from rg-tools-dev Service Bus namespace>
QUEUE_NAME=image-jobs
